# Git
.git
.gitignore

# Python
__pycache__
*.py[cod]
*$py.class
*.so
.Python
.venv
venv/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Logs (will be mounted as volume)
logs/

# Data (will be mounted as volume)
data/

# Uploads (will be mounted as volume)
uploads/

# Claude
.claude/

# Documentation（排除文档目录，但保留运行时 /api-reference 接口读取的手册）
docs/*
*.md
# 否定规则须放在最后：dockerignore 最后匹配的规则生效，避免被上面的 *.md 覆盖
!docs/API_FULL_REFERENCE.md

# Build artifacts
dist/
build/
*.egg-info/

# OS files
.DS_Store
Thumbs.db

# Deploy scripts (not needed in container)
deploy.sh
